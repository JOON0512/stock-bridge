# 이 파일을 .env로 복사하고 로컬 편집기로 입력하세요. 채팅에 키를 보내지 마세요.
TOSS_LIVE_CLIENT_ID=
TOSS_LIVE_CLIENT_SECRET=
# accounts 명령의 accountSeq (실제 계좌번호가 아님)
TOSS_LIVE_ACCOUNT=
KIS_DEMO_APP_KEY=
KIS_DEMO_APP_SECRET=
# 계좌 8자리 + 상품코드 2자리, 예: 12345678-01
KIS_DEMO_ACCOUNT=
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT=
KIWOOM_DEMO_APP_KEY=
KIWOOM_DEMO_APP_SECRET=
# 해당 앱키에 연결된 10자리 계좌번호
KIWOOM_DEMO_ACCOUNT=
KIWOOM_LIVE_APP_KEY=
KIWOOM_LIVE_APP_SECRET=
KIWOOM_LIVE_ACCOUNT=
